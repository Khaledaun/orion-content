
# Database
DATABASE_URL="postgresql://username:password@your-host.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://username:password@your-host.neon.tech/dbname?sslmode=require"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-here-must-be-at-least-32-characters-long"

# JWT and Encryption
JWT_SECRET="your-jwt-secret-key-here-must-be-at-least-32-characters-long"
ENCRYPTION_KEY="your-32-character-encryption-key-here"

# Redis for Sessions and Rate Limiting
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_TOKEN="your-upstash-redis-token"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Email for 2FA and Notifications
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Rate Limiting Configuration
RATE_LIMIT_REQUESTS="100"
RATE_LIMIT_WINDOW="900000"

# Security Features
ENABLE_2FA="true"
ENABLE_AUDIT_LOGGING="true"

# API Keys
OPENAI_API_KEY="your-openai-api-key"
GOOGLE_ANALYTICS_KEY="your-google-analytics-key"
GOOGLE_SEARCH_CONSOLE_KEY="your-google-search-console-key"

# WordPress Integration
WORDPRESS_API_URL="https://your-wordpress-site.com/wp-json/wp/v2"
WORDPRESS_USERNAME="your-wordpress-username"
WORDPRESS_APP_PASSWORD="your-wordpress-app-password"

# Site Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Orion CMS"

# SEO Verification
GOOGLE_SITE_VERIFICATION="your-google-site-verification-code"
YANDEX_VERIFICATION="your-yandex-verification-code"
YAHOO_VERIFICATION="your-yahoo-verification-code"

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# File Upload
MAX_FILE_SIZE="10485760"
ALLOWED_FILE_TYPES="jpg,jpeg,png,gif,pdf,doc,docx"

# Development
NODE_ENV="development"
LOG_LEVEL="info"
ENABLE_DEBUG="false"

# Feature Flags
ENABLE_ANALYTICS="true"
ENABLE_SEO_TOOLS="true"
ENABLE_AUTOMATION="true"
ENABLE_COMPETITIVE_ANALYSIS="true"
