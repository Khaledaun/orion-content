
# Database
DATABASE_URL="postgresql://username:password@localhost:5432/orion_cms"
DIRECT_URL="postgresql://username:password@localhost:5432/orion_cms"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# API Keys
OPENAI_API_KEY="your-openai-api-key"
GOOGLE_ANALYTICS_KEY="your-google-analytics-key"
GOOGLE_SEARCH_CONSOLE_KEY="your-google-search-console-key"

# WordPress Integration
WORDPRESS_API_URL="https://your-wordpress-site.com/wp-json/wp/v2"
WORDPRESS_USERNAME="your-wordpress-username"
WORDPRESS_APP_PASSWORD="your-wordpress-app-password"

# Redis (optional, for caching)
REDIS_URL="redis://localhost:6379"

# Email (optional, for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Site Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Orion CMS"

# SEO Verification
GOOGLE_SITE_VERIFICATION="your-google-site-verification-code"
YANDEX_VERIFICATION="your-yandex-verification-code"
YAHOO_VERIFICATION="your-yahoo-verification-code"

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# Security
ENCRYPTION_KEY="your-32-character-encryption-key"
JWT_SECRET="your-jwt-secret-key"

# Feature Flags
ENABLE_ANALYTICS="true"
ENABLE_SEO_TOOLS="true"
ENABLE_AUTOMATION="true"
ENABLE_COMPETITIVE_ANALYSIS="true"

# Rate Limiting
RATE_LIMIT_REQUESTS="100"
RATE_LIMIT_WINDOW="900000"

# File Upload
MAX_FILE_SIZE="10485760"
ALLOWED_FILE_TYPES="jpg,jpeg,png,gif,pdf,doc,docx"

# Development
NODE_ENV="development"
LOG_LEVEL="info"
ENABLE_DEBUG="false"
