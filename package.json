
{
  "name": "orion-content",
  "version": "1.0.0",
  "description": "Orion Content Management System with GitHub Copilot Integration",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:db": "jest --testPathPattern=database",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:validate": "prisma validate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "validate": "./scripts/validate.sh",
    "audit": "npm audit --audit-level=moderate",
    "outdated": "npm outdated",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "lighthouse": "lighthouse-ci autorun",
    "analyze": "cross-env ANALYZE=true next build",
    "clean": "rm -rf .next out dist build",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@prisma/client": "^5.0.0",
    "typescript": "^5.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.44.0",
    "eslint-config-next": "^14.0.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.0.0",
    "@trivago/prettier-plugin-sort-imports": "^4.1.1",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.3",
    "prisma": "^5.0.0",
    "tsx": "^3.12.7",
    "jest": "^29.6.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/jest-dom": "^5.16.5",
    "jest-environment-jsdom": "^29.6.0",
    "cross-env": "^7.0.3",
    "@next/bundle-analyzer": "^14.0.0",
    "lighthouse-ci": "^0.12.0",
    "pre-commit": "^1.2.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Khaledaun/orion-content.git"
  },
  "keywords": [
    "nextjs",
    "typescript",
    "prisma",
    "github-copilot",
    "edge-runtime",
    "content-management"
  ],
  "author": "Orion Content Team",
  "license": "MIT"
}
