{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "functions": {
    "app/api/seo/audit/route.ts": {
      "maxDuration": 300
    },
    "app/api/seo/audit/[auditId]/route.ts": {
      "maxDuration": 60
    },
    "app/api/wordpress/seo/route.ts": {
      "maxDuration": 120
    },
    "app/api/seo/external/route.ts": {
      "maxDuration": 60
    }
  },
  "env": {
    "NODE_ENV": "production"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/seo/(.*)",
      "destination": "/api/seo/$1"
    },
    {
      "source": "/api/wordpress/(.*)",
      "destination": "/api/wordpress/$1"
    }
  ]
}
